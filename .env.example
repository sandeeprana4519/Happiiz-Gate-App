# ====================================================================
# HAPPIIZ GATE APP — ENVIRONMENT CONFIGURATION
# ====================================================================
# Rename or copy this file to `.env` or `.env.local` for local execution.
# On Hostinger, set these variables in your deployment environment or build step.

# --------------------------------------------------------------------
# 1. FIREBASE WEB CLIENT CONFIGURATION (PRODUCTION)
# Obtain these from your Firebase Console > Project Settings > General > Your Apps (Web App)
# Note: These client keys identify your Firebase project to the browser SDK.
# Security is enforced server-side using Firebase Security Rules (firestore.rules & storage.rules).
# --------------------------------------------------------------------
VITE_FIREBASE_API_KEY="AIzaSyYourApiKeyHere"
VITE_FIREBASE_AUTH_DOMAIN="happiiz-gate.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="happiiz-gate-prod"
VITE_FIREBASE_STORAGE_BUCKET="happiiz-gate.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456789"
VITE_FIREBASE_MEASUREMENT_ID="G-ABC123XYZ"

# --------------------------------------------------------------------
# 2. APPLICATION RUNTIME & PREVIEW MODES
# --------------------------------------------------------------------
# Set to 'development' or 'production'
VITE_APP_ENV="development"

# When true or when Firebase keys are absent, enables high-fidelity dev preview
# with instant role switching between Super Admin, Society Admin, Guard, Resident & Partner.
VITE_ENABLE_DEV_MOCK_AUTH="true"

# Cloud hosting base URL for self-referential links and PWA manifest scope
APP_URL="http://localhost:3000"
