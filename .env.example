# ====================================================================
# HAPPIIZ GATE APP — ENVIRONMENT CONFIGURATION TEMPLATE
# ====================================================================
# Copy to `.env` (or `.env.local`) for local development.
# NEVER commit real secrets or private keys to version control.

# 1. FIREBASE WEB CLIENT CONFIGURATION
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
VITE_FIREBASE_MEASUREMENT_ID="YOUR_MEASUREMENT_ID"

# 2. RUNTIME MODE
# Use 'development' locally, 'production' when building for Hostinger
VITE_APP_ENV="development"

# Set to "false" for all production builds. Set to "true" only for local UI previews.
VITE_ENABLE_DEV_MOCK_AUTH="false"

# Base URL for server-side links
APP_URL="http://localhost:3000"

# 3. SERVER-SIDE AI ANPR ENGINE (NEVER PREFIX WITH VITE_)
ANPR_PROVIDER="gemini_vision"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
ANPR_MIN_CONFIDENCE="72"
PLATE_RECOGNIZER_API_KEY=""
