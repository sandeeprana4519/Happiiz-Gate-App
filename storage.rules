rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    // User Profile Avatars
    match /avatars/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) && isImage() && isUnder5MB();
    }

    // Verification Documents & Proof of Residency
    match /documents/{societyId}/{userId}/{fileName} {
      allow read: if isAuthenticated() && (request.auth.uid == userId);
      allow write: if isOwner(userId) && isUnder5MB();
    }

    // Visitor Photos captured at Security Gate Terminal
    match /visitors/{societyId}/{fileName} {
      allow read, write: if isAuthenticated() && isImage() && isUnder5MB();
    }
  }
}
