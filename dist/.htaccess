Options -Indexes
DirectoryIndex index.html

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType application/javascript .js
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Enforce HTTPS when running on live Hostinger production domain
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Allow scoped PWA static directories (/guard/, /supporter/, /partner/) root entry
  # to boot the SPA directly instead of returning Apache 403 directory listing denied
  RewriteRule ^(guard|supporter|partner)/?$ /index.html [L]

  # Never rewrite direct index.html or API endpoints
  RewriteRule ^index\.html$ - [L]
  RewriteRule ^api/ - [L]

  # Serve existing static files (manifests, sw.js, offline.html, icons, JS/CSS bundles)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d [OR]
  RewriteCond %{REQUEST_FILENAME} -l
  RewriteRule ^ - [L]

  # Single Page Application Fallback for all React Router paths
  RewriteRule . /index.html [L]
</IfModule>

# Security and Cache-Control Headers for Hostinger
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(self)"

  # Long-lived immutable caching for hashed Vite build assets & images
  <FilesMatch "\.(ico|jpe?g|png|gif|webp|css|js|svg|woff2?|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Never cache Service Workers, Web App Manifests, Offline Fallbacks, or index.html
  <FilesMatch "^(index\.html|offline\.html|sw\.js|registerSW\.js|manifest\.webmanifest)$">
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
